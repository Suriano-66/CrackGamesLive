# ----------------------------------------------------------------------------
# CrackGamesLive — variables d'environnement
# Copie ce fichier en `.env` et remplis les valeurs. Ne commit JAMAIS le .env.
# ----------------------------------------------------------------------------

# Base de données
# En dev : SQLite (aucune installation). En prod : mets une URL PostgreSQL
# (ex: postgresql://user:pass@host:5432/crackgameslive) et change le
# `provider` dans prisma/schema.prisma en "postgresql".
DATABASE_URL="file:./dev.db"

# Auth.js — secret de signature des sessions (OBLIGATOIRE)
# Génère-en un avec :  openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-un-secret-aleatoire-long"

# URL publique du site (sans slash final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Stripe — récupère ces clés sur https://dashboard.stripe.com
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Secret du webhook Stripe (obtenu via `stripe listen` ou le dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Identifiants de prix Stripe (un par formule × période)
# Crée 9 "prices" dans Stripe (3 offres × 3 périodes) et colle les IDs ici.
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_QUARTERLY="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_CREATOR_MONTHLY="price_..."
STRIPE_PRICE_CREATOR_QUARTERLY="price_..."
STRIPE_PRICE_CREATOR_YEARLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_QUARTERLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
