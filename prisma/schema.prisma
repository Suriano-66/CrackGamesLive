// CrackGamesLive — schéma de base de données
// Dev : SQLite (zéro installation). Prod : passe `provider` à "postgresql"
// et mets une DATABASE_URL PostgreSQL dans le .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  // Rôle : "user" (membre / streamer), "support", "admin".
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Facturation Stripe
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  plan                   String?   // "starter" | "creator" | "pro"
  subscriptionStatus     String?   // "active" | "trialing" | "past_due" | "canceled" ...
  currentPeriodEnd       DateTime?
  // true = accès offert manuellement par un admin (hors Stripe).
  manualAccess           Boolean   @default(false)
  // Jeton secret pour les liens overlay OBS (unique, régénérable).
  overlayToken           String?   @unique
  // Nom d'utilisateur TikTok (@pseudo) dont on écoute le live.
  tiktokUsername         String?
}

// Niveaux créés dans l'éditeur (data-driven).
model Level {
  id        String   @id @default(cuid())
  gameType  String   @default("marble-race")
  name      String
  data      String // JSON : { platforms: [...], settings: {...} }
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Traçabilité (qui a créé / modifié en dernier).
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  // Verrou d'édition : qui édite en ce moment (heartbeat via lockedAt).
  lockedById   String?
  lockedByName String?
  lockedAt     DateTime?

  versions LevelVersion[]

  @@index([gameType, active])
}

// Historique : une entrée par sauvegarde explicite (retour arrière possible).
model LevelVersion {
  id          String   @id @default(cuid())
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  data        String
  savedById   String?
  savedByName String?
  label       String?
  createdAt   DateTime @default(now())

  @@index([levelId, createdAt])
}

// Catalogue de jeux géré depuis le back-office.
model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  emoji       String   @default("🎮")
  description String   @default("")
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
