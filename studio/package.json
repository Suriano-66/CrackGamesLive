{
  "name": "crackgames-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio d'édition de niveaux CrackGamesLive (outil développeur, application de bureau)",
  "author": "CrackGamesLive",
  "main": "main.js",
  "scripts": {
    "assets": "node scripts/prepare.mjs",
    "postinstall": "node scripts/prepare.mjs",
    "start": "npm run assets && electron .",
    "dist:win": "npm run assets && electron-builder --win --x64"
  },
  "devDependencies": {
    "three": "0.171.0",
    "cannon-es": "0.20.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "live.crackgames.studio",
    "productName": "CrackGames Studio",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "vendor/**/*",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
